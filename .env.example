# =============================================================================
# Siphon Migrator — Environment Configuration Example
# Copy to .env for local development. NEVER commit real keys or .env files.
# =============================================================================

# --- Server, Persistence & Security ---
# Bind host (non-loopback hosts such as 0.0.0.0 REQUIRE SIPHON_ADMIN_SESSION_TOKEN)
HOST=127.0.0.1
PORT=4420

# Optional directory for atomic JSON persistent state (jobs, mandates, tokens, replay digests).
# Leave empty to keep ephemeral in-memory storage (default for local dev/tests).
SIPHON_DATA_DIR=

# REQUIRED when HOST is non-loopback (e.g. 0.0.0.0). Generate with: openssl rand -hex 32
SIPHON_ADMIN_SESSION_TOKEN=

# Comma-separated production hostnames & CORS origins (required for public HTTPS deployments)
SIPHON_ALLOWED_HOSTS=
SIPHON_ALLOWED_ORIGIN=
SIPHON_PUBLIC_BASE_URL=

# Require Bearer token auth for external Claude MCP & ChatGPT Action endpoints (default: true)
SIPHON_REQUIRE_PLUGIN_AUTH=true

# Trust Fly-Client-IP / X-Forwarded-For headers behind a reverse proxy (default: false unless Fly.io)
SIPHON_TRUST_PROXY=false

# --- Rate Limiting & RPC Circuit Breaker ---
# Sliding-window max requests per IP or Bearer token per window (default: 240 / 60s)
SIPHON_RATE_LIMIT_MAX=240
SIPHON_RATE_LIMIT_WINDOW_MS=60000
SIPHON_RATE_LIMIT_DISABLED=false

# Cooldown duration (ms) for 429'd or repeatedly rate-limited RPC endpoints (default: 60000)
SIPHON_RPC_COOLDOWN_MS=60000

# --- Protocol Fee & Treasury Configuration ---
# Optional default fee override in bps (0-1000)
SIPHON_FEE_BPS=
# Server-configured EVM treasury address (required for live gasless EIP-712 payloads)
SIPHON_FEE_RECIPIENT_EVM=
SIPHON_FEE_RECIPIENT_SOL=
SIPHON_FEE_RECIPIENT_SOLANA=
# contract | wallet
SIPHON_FEE_DESTINATION_TYPE=contract
SIPHON_FEE_RECIPIENT_COSMOS=
SIPHON_FEE_RECIPIENT_SUI=
SIPHON_FEE_RECIPIENT_APTOS=
SIPHON_FEE_RECIPIENT_TON=
SIPHON_FEE_RECIPIENT_TRON=
SIPHON_THORNAME_AFFILIATE=

# --- Sponsored Gasless Relayer & Deployed Router/Delegate Contracts ---
# 32-byte hex EVM private key for broadcasting sponsored EIP-1559 relayer txs (keep in secret manager!)
SIPHON_RELAYER_PRIVATE_KEY=

# Deployed SiphonRouter contract addresses per chain
SIPHON_ROUTER_ETHEREUM=
SIPHON_ROUTER_BASE=
SIPHON_ROUTER_ARBITRUM=
SIPHON_ROUTER_OPTIMISM=
SIPHON_ROUTER_POLYGON=
SIPHON_ROUTER_AVALANCHE=
SIPHON_ROUTER_BNB=
SIPHON_ROUTER_SONIC=
SIPHON_ROUTER_UNICHAIN=
SIPHON_ROUTER_LINEA=
SIPHON_ROUTER_SCROLL=
SIPHON_ROUTER_MANTLE=
SIPHON_ROUTER_BLAST=
SIPHON_ROUTER_WORLDCHAIN=

# Optional deployed EIP-7702 SiphonSweepDelegate addresses per chain
SIPHON_DELEGATE_ETHEREUM=
SIPHON_DELEGATE_BASE=
SIPHON_DELEGATE_ARBITRUM=
SIPHON_DELEGATE_OPTIMISM=
SIPHON_DELEGATE_POLYGON=

# Optional non-EVM gasless relayer credentials
SIPHON_COSMOS_RELAYER_KEY=
SIPHON_COSMOS_FEE_GRANTER=
SIPHON_SUI_SPONSOR_PRIVATE_KEY=
SIPHON_APTOS_FEE_PAYER_KEY=
SIPHON_TON_RELAYER_KEY=
SIPHON_TRON_RELAYER_KEY=

# --- EVM, Solana & Non-EVM RPC Endpoints (optional keyed overrides) ---
ETH_RPC_URL=
BASE_RPC_URL=
ARB_RPC_URL=
OP_RPC_URL=
POLYGON_RPC_URL=
AVAX_RPC_URL=
BNB_RPC_URL=
SONIC_RPC_URL=
UNICHAIN_RPC_URL=
LINEA_RPC_URL=
SCROLL_RPC_URL=
MANTLE_RPC_URL=
BLAST_RPC_URL=
WORLDCHAIN_RPC_URL=
SOLANA_RPC_URL=
SUI_RPC_URL=
SUI_GRAPHQL_URL=
APTOS_RPC_URL=
APTOS_INDEXER_URL=

# --- Indexer, Aggregator, Bridge & Wallet Provider API Keys (all optional) ---
ALCHEMY_API_KEY=
SIM_API_KEY=
MORALIS_API_KEY=
ENSO_API_KEY=
RELAY_API_KEY=
LIFI_API_KEY=
JUPITER_API_KEY=
WALLETCONNECT_PROJECT_ID=
APTOS_API_KEY=
TONAPI_KEY=
TRONGRID_API_KEY=
