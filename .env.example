# =============================================================================
# Turgalium Migrator — Environment Configuration Example
# Copy to .env for local development. NEVER commit real keys or .env files.
# =============================================================================

# --- Server, Persistence & Security ---
# Bind host (non-loopback hosts such as 0.0.0.0 REQUIRE TURGALIUM_ADMIN_SESSION_TOKEN)
HOST=127.0.0.1
PORT=4420

# Optional directory for atomic JSON persistent state (jobs, mandates, tokens, replay digests).
# Leave empty to keep ephemeral in-memory storage (default for local dev/tests).
TURGALIUM_DATA_DIR=

# REQUIRED when HOST is non-loopback (e.g. 0.0.0.0). Generate with: openssl rand -hex 32
TURGALIUM_ADMIN_SESSION_TOKEN=

# Comma-separated production hostnames & CORS origins (required for public HTTPS deployments)
TURGALIUM_ALLOWED_HOSTS=
TURGALIUM_ALLOWED_ORIGIN=
TURGALIUM_PUBLIC_BASE_URL=

# Require Bearer token auth for external Claude MCP & ChatGPT Action endpoints (default: true)
TURGALIUM_REQUIRE_PLUGIN_AUTH=true

# Trust Fly-Client-IP / X-Forwarded-For headers behind a reverse proxy (default: false unless Fly.io)
TURGALIUM_TRUST_PROXY=false

# --- Rate Limiting & RPC Circuit Breaker ---
# Sliding-window max requests per IP or Bearer token per window (default: 240 / 60s)
TURGALIUM_RATE_LIMIT_MAX=240
TURGALIUM_RATE_LIMIT_WINDOW_MS=60000
TURGALIUM_RATE_LIMIT_DISABLED=false

# Cooldown duration (ms) for 429'd or repeatedly rate-limited RPC endpoints (default: 60000)
TURGALIUM_RPC_COOLDOWN_MS=60000

# --- Open-Source Zero-Fee Default (Optional Fork Overrides Only) ---
# Turgalium charges 0% protocol fees by default (MIT open source).
# Leave empty unless running a custom self-hosted fork with an explicit bps fee (0-1000).
TURGALIUM_FEE_BPS=
TURGALIUM_FEE_RECIPIENT_EVM=
TURGALIUM_FEE_RECIPIENT_SOL=
TURGALIUM_FEE_RECIPIENT_SOLANA=
TURGALIUM_FEE_DESTINATION_TYPE=contract
TURGALIUM_FEE_RECIPIENT_COSMOS=
TURGALIUM_FEE_RECIPIENT_SUI=
TURGALIUM_FEE_RECIPIENT_APTOS=
TURGALIUM_FEE_RECIPIENT_TON=
TURGALIUM_FEE_RECIPIENT_TRON=
TURGALIUM_THORNAME_AFFILIATE=

# --- Sponsored Gasless Relayer & Deployed Router/Delegate Contracts ---
# 32-byte hex EVM private key for broadcasting sponsored EIP-1559 relayer txs (keep in secret manager!)
TURGALIUM_RELAYER_PRIVATE_KEY=

# Deployed TurgaliumRouter contract addresses per chain
TURGALIUM_ROUTER_ETHEREUM=
TURGALIUM_ROUTER_BASE=
TURGALIUM_ROUTER_ARBITRUM=
TURGALIUM_ROUTER_OPTIMISM=
TURGALIUM_ROUTER_POLYGON=
TURGALIUM_ROUTER_AVALANCHE=
TURGALIUM_ROUTER_BNB=
TURGALIUM_ROUTER_SONIC=
TURGALIUM_ROUTER_UNICHAIN=
TURGALIUM_ROUTER_LINEA=
TURGALIUM_ROUTER_SCROLL=
TURGALIUM_ROUTER_MANTLE=
TURGALIUM_ROUTER_BLAST=
TURGALIUM_ROUTER_WORLDCHAIN=

# Optional deployed EIP-7702 TurgaliumSweepDelegate addresses per chain
TURGALIUM_DELEGATE_ETHEREUM=
TURGALIUM_DELEGATE_BASE=
TURGALIUM_DELEGATE_ARBITRUM=
TURGALIUM_DELEGATE_OPTIMISM=
TURGALIUM_DELEGATE_POLYGON=

# Optional deployed TurgaliumFlashUnwind addresses (0% fee atomic Aave V3 / Neverland flash-loan unwind)
# Deploy via contracts/script/DeployTurgaliumFlashUnwind.s.sol
TURGALIUM_FLASH_UNWIND_DEFAULT=
TURGALIUM_FLASH_UNWIND_MONAD=
TURGALIUM_FLASH_UNWIND_ETHEREUM=
TURGALIUM_FLASH_UNWIND_BASE=
TURGALIUM_FLASH_UNWIND_ARBITRUM=
TURGALIUM_FLASH_UNWIND_OPTIMISM=
TURGALIUM_FLASH_UNWIND_POLYGON=
TURGALIUM_FLASH_UNWIND_AVALANCHE=
TURGALIUM_FLASH_UNWIND_BNB=
TURGALIUM_FLASH_UNWIND_GNOSIS=
TURGALIUM_FLASH_UNWIND_MANTLE=
TURGALIUM_FLASH_UNWIND_HYPEREVM=

# Optional non-EVM gasless relayer credentials
TURGALIUM_COSMOS_RELAYER_KEY=
TURGALIUM_COSMOS_FEE_GRANTER=
TURGALIUM_SUI_SPONSOR_PRIVATE_KEY=
TURGALIUM_APTOS_FEE_PAYER_KEY=
TURGALIUM_TON_RELAYER_KEY=
TURGALIUM_TRON_RELAYER_KEY=

# --- EVM, Solana & Non-EVM RPC Endpoints (optional keyed overrides) ---
ETH_RPC_URL=
BASE_RPC_URL=
ARB_RPC_URL=
OP_RPC_URL=
POLYGON_RPC_URL=
AVAX_RPC_URL=
BNB_RPC_URL=
SONIC_RPC_URL=
UNICHAIN_RPC_URL=
LINEA_RPC_URL=
SCROLL_RPC_URL=
MANTLE_RPC_URL=
BLAST_RPC_URL=
WORLDCHAIN_RPC_URL=
HYPEREVM_RPC_URL=
BERACHAIN_RPC_URL=
ZKSYNC_RPC_URL=
INK_RPC_URL=
GNOSIS_RPC_URL=
SOLANA_RPC_URL=
SUI_RPC_URL=
SUI_GRAPHQL_URL=
APTOS_RPC_URL=
APTOS_INDEXER_URL=

# --- Indexer, Aggregator, Bridge & Wallet Provider API Keys (all optional) ---
ALCHEMY_API_KEY=
SIM_API_KEY=
MORALIS_API_KEY=
ENSO_API_KEY=
RELAY_API_KEY=
LIFI_API_KEY=
JUPITER_API_KEY=
