{
  "name": "turgalium-migrator",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Zero-fee open-source 30-chain DeFi & dust migrator to Solana with 1-click DeFi extraction, EIP-5792/7702 batching, Circle CCTP V2 Fast Transfer, and Claude MCP / ChatGPT plugins",
  "homepage": "https://turgalium.vercel.app",
  "bugs": {
    "url": "https://github.com/TrustlessMike/turgalium/issues"
  },
  "keywords": [
    "solana",
    "defi",
    "cross-chain",
    "cctp",
    "eip-7702",
    "mcp",
    "open-source",
    "zero-fee"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TrustlessMike/turgalium.git"
  },
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "start": "node dist/src/server/index.js",
    "mcp": "node dist/src/mcp/server.js",
    "build:vendor": "node scripts/build-vendor.mjs",
    "build": "tsc && npm run build:vendor",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "python3 tests/e2e-playwright.py"
  },
  "dependencies": {
    "@coinbase/wallet-sdk": "^4.4.0",
    "@noble/hashes": "^1.4.0",
    "@solana/web3.js": "^1.98.0",
    "@walletconnect/ethereum-provider": "^2.26.0",
    "three": "^0.174.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "jayson": "^5.0.0",
    "zod": "^4.6.6",
    "abitype": "^1.2.3",
    "uuid": "^11.1.1"
  }
}
